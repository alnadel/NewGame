{
  "name": "newgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --outDir dist-single && node scripts/inline-build.mjs dist-single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
