{
  "name": "newgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "build:single": "vite build --outDir dist-single && node scripts/inline-build.mjs dist-single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sim": "node scripts/sim.ts",
    "test:all": "npm run typecheck && npm test && npm run sim -- --check --seeds 50 && npm run e2e",
    "golden": "node scripts/golden.ts",
    "icons": "node scripts/gen-icons.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
